# Run the actual executable and check exit status, stdout and stderr separately.
file(MAKE_DIRECTORY "${WORK}")
set(header "type,id,side,price,quantity\n")
set(expected_code 0)
set(expected_error "")
set(args replay "${WORK}/input file.csv")
set(expected_output "")
if(CASE STREQUAL "sample")
    set(args replay "${FIXTURE}")
    set(expected_output "Events: 8\nAccepted: 5\nRejected: 3\nRemaining orders: 2\nPrices: internal scaled integer units (scale 10000)\nBest bid: 1000000\nBest ask: 1050000\n")
elseif(CASE STREQUAL "invalid_args" OR CASE STREQUAL "missing_argument" OR CASE STREQUAL "extra_argument")
    if(CASE STREQUAL "invalid_args")
        set(args unknown file.csv)
    elseif(CASE STREQUAL "missing_argument")
        set(args replay)
    else()
        set(args replay file.csv extra)
    endif()
    set(expected_code 1)
    set(expected_error "Usage: marketreplay replay <csv-path>\n")
elseif(CASE STREQUAL "missing_file")
    file(REMOVE "${WORK}/input file.csv")
    set(expected_code 1)
    set(expected_error "Failed to open CSV file: ${WORK}/input file.csv\n")
elseif(CASE STREQUAL "malformed")
    file(WRITE "${WORK}/input file.csv" "${header}ADD,1,BUY,100,5\n\nADD,2,BUY,100,0\n")
    set(expected_code 1)
    set(expected_error "CSV error at line 4: Invalid ADD quantity\n")
elseif(CASE STREQUAL "empty_file")
    file(WRITE "${WORK}/input file.csv" "")
    set(expected_code 1)
    set(expected_error "CSV error at line 1: Missing CSV header\n")
elseif(CASE STREQUAL "header_only" OR CASE STREQUAL "removed_all")
    if(CASE STREQUAL "header_only")
        file(WRITE "${WORK}/input file.csv" "${header}")
        set(count 0)
    else()
        file(WRITE "${WORK}/input file.csv" "${header}ADD,1,BUY,100,5\nCANCEL,1,,,5\nADD,2,SELL,105,2\nDELETE,2,,,\n")
        set(count 4)
    endif()
    set(expected_output "Events: ${count}\nAccepted: ${count}\nRejected: 0\nRemaining orders: 0\nPrices: internal scaled integer units (scale 10000)\nBest bid: N/A\nBest ask: N/A\n")
elseif(CASE STREQUAL "buy_only")
    file(WRITE "${WORK}/input file.csv" "${header}ADD,1,BUY,100,5\n")
    set(expected_output "Events: 1\nAccepted: 1\nRejected: 0\nRemaining orders: 1\nPrices: internal scaled integer units (scale 10000)\nBest bid: 100\nBest ask: N/A\n")
else()
    message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()
execute_process(COMMAND "${PROGRAM}" ${args}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\r\n" "\n" error "${error}")
if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Exit: ${code}, expected ${expected_code}; stderr: ${error}")
endif()
if(NOT "${output}" STREQUAL "${expected_output}")
    message(FATAL_ERROR "Unexpected stdout: [${output}], expected [${expected_output}]")
endif()
if(NOT "${error}" STREQUAL "${expected_error}")
    message(FATAL_ERROR "Unexpected stderr: [${error}], expected [${expected_error}]")
endif()
